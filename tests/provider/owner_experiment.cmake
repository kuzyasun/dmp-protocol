# Manifest-derived provider-only sensitivity inputs, not deployment profiles.
set(_owner_manifest "${CMAKE_CURRENT_SOURCE_DIR}/experiment_manifest.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_owner_manifest}")
file(READ "${_owner_manifest}" _owner_json)
set(_owner_header "/* Generated test-only provider sensitivity inputs. */\n")
string(APPEND _owner_header "typedef struct { const char *name; size_t peers, pending, active, draining, slots, child_objects; } owner_case;\nstatic const owner_case owner_cases[] = {\n")
string(JSON _count LENGTH "${_owner_json}" sensitivity_rows)
if(_count LESS 1)
    message(FATAL_ERROR "MEM-03 needs at least one sensitivity row")
endif()
math(EXPR _last "${_count} - 1")
set(_saw_single FALSE)
set(_saw_four_serial FALSE)
set(_saw_four_parallel FALSE)
foreach(_i RANGE ${_last})
    string(JSON _name GET "${_owner_json}" sensitivity_rows ${_i} name)
    if(NOT _name MATCHES "^[a-zA-Z0-9_]+$")
        message(FATAL_ERROR "Invalid owner-case name")
    endif()
    foreach(_field peers pending_attempts active_associations draining_associations crypto_slots)
        string(JSON _value GET "${_owner_json}" sensitivity_rows ${_i} ${_field})
        if(NOT _value MATCHES "^[1-4]$")
            message(FATAL_ERROR "MEM-03 test capacity exceeded: ${_name}/${_field}")
        endif()
        set(_${_field} "${_value}")
    endforeach()
    math(EXPR _child_objects "${_pending_attempts} + 2 * (${_active_associations} + ${_draining_associations}) + 2 * ${_crypto_slots}")
    if(_name STREQUAL "single" AND NOT _child_objects EQUAL 7)
        message(FATAL_ERROR "single provider child-object derivation changed: ${_child_objects}")
    elseif(_name STREQUAL "single")
        set(_saw_single TRUE)
    elseif(_name STREQUAL "four_serial" AND NOT _child_objects EQUAL 22)
        message(FATAL_ERROR "four_serial provider child-object derivation changed: ${_child_objects}")
    elseif(_name STREQUAL "four_serial")
        set(_saw_four_serial TRUE)
    elseif(_name STREQUAL "four_parallel" AND NOT _child_objects EQUAL 24)
        message(FATAL_ERROR "four_parallel provider child-object derivation changed: ${_child_objects}")
    elseif(_name STREQUAL "four_parallel")
        set(_saw_four_parallel TRUE)
    endif()
    if(_child_objects GREATER 24)
        message(FATAL_ERROR "${_name} exceeds the provider hard child-object maximum: ${_child_objects}")
    endif()
    string(APPEND _owner_header "{\"${_name}\", ${_peers}, ${_pending_attempts}, ${_active_associations}, ${_draining_associations}, ${_crypto_slots}, ${_child_objects}},\n")
endforeach()
if(NOT _saw_single OR NOT _saw_four_serial OR NOT _saw_four_parallel)
    message(FATAL_ERROR "provider sensitivity rows single/four_serial/four_parallel are required")
endif()
string(APPEND _owner_header "};\ntypedef struct { const char *name; size_t retained; } owner_budget;\nstatic const owner_budget owner_budgets[] = {\n")
string(JSON _count LENGTH "${_owner_json}" proposed_envelopes_per_target_bytes)
if(_count LESS 1)
    message(FATAL_ERROR "MEM-03 needs at least one retained slice")
endif()
math(EXPR _last "${_count} - 1")
foreach(_i RANGE ${_last})
    string(JSON _name GET "${_owner_json}" proposed_envelopes_per_target_bytes ${_i} name)
    string(JSON _bytes GET "${_owner_json}" proposed_envelopes_per_target_bytes ${_i} retained)
    if(NOT _name MATCHES "^[a-zA-Z0-9_]+$" OR NOT _bytes MATCHES "^[0-9]+$"
       OR _bytes LESS 4096 OR _bytes GREATER 32768)
        message(FATAL_ERROR "MEM-03 retained slice must be 4096..32768 bytes")
    endif()
    string(APPEND _owner_header "{\"${_name}\", ${_bytes}},\n")
endforeach()
string(APPEND _owner_header "};\n")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/noise_owner_cases.h" CONTENT "${_owner_header}")

dmp_add_provider_experiment(dmp_noise_owners_probe noise_owners_probe.c
    noise_owner_fixture.c noise_test_arena.c noise_checked_fixture_port.c "${_fixture_header}")
target_include_directories(dmp_noise_owners_probe PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
target_compile_definitions(dmp_noise_owners_probe PRIVATE DMP_TEST_NOISE_ENTROPY_PORT=1)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(dmp_noise_owners_probe PRIVATE -fno-strict-aliasing)
endif()
target_link_libraries(dmp_noise_owners_probe PRIVATE dmp_noise_arena)
set_tests_properties(dmp_noise_owners_probe PROPERTIES TIMEOUT 120 LABELS "provider-live-owner-experiment")
if(WIN32 AND CMAKE_C_COMPILER_ID STREQUAL "GNU")
    target_sources(dmp_noise_owners_probe PRIVATE noise_checked_no_legacy_rng.c)
    target_link_options(dmp_noise_owners_probe PRIVATE
        "-Wl,--wrap=randombytes_stir" "-Wl,--wrap=randombytes_buf")
endif()

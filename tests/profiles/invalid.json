    {
      "name": "bootstrap-crc-descriptor-and-payload-at-mtu-boundary",
      "fixture": "direct.json",
      "mutations": [
        {
          "op": "set",
          "path": "/limits/bootstrap_chunk_bytes",
          "value": 119
        },
        {
          "op": "set",
          "path": "/binding/forward_mtu",
          "value": 144
        },
        {
          "op": "set",
          "path": "/binding/return_mtu",
          "value": 144
        },
        {
          "op": "set",
          "path": "/binding/encoded_mtu",
          "value": 150
        }
      ],
      "expected_code": "mtu",
      "expected_path": "$.binding",
      "expected_math": {
        "bootstrap_header_bytes": 22,
        "bootstrap_chunk_bytes": 119,
        "crc32c_trailer_bytes": 4,
        "bootstrap_frame_bytes": 145,
        "path_mtu": 144
      }
    },

  "raw_cases": [
    {
      "name": "invalid-utf8",
      "hex": "ff",
      "expected_code": "encoding",
      "expected_path": "$"
    },
    {
      "name": "bom",
      "hex": "efbbbf7b7d",
      "expected_code": "encoding",
      "expected_path": "$"
    },
    {
      "name": "duplicate-member",
      "ascii": "{\"x\":1,\"x\":2}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "escape-equivalent-duplicate-member",
      "ascii": "{\"x\":1,\"\\u0078\":2}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "unpaired-surrogate",
      "ascii": "{\"x\":\"\\ud800\"}",
      "expected_code": "encoding",
      "expected_path": "$"
    },
    {
      "name": "floating-point-number",
      "ascii": "{\"x\":1.0}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "exponent-number",
      "ascii": "{\"x\":1e0}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "nan-number",
      "ascii": "{\"x\":NaN}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "infinity-number",
      "ascii": "{\"x\":Infinity}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "trailing-json-value",
      "ascii": "{}{}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "comment-syntax",
      "ascii": "{/*comment*/}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "nesting-over-24-containers",
      "repeat_prefix_hex": "5b",
      "repeat": 25,
      "middle_ascii": "0",
      "repeat_suffix_hex": "5d",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "nesting-at-24-container-limit-is-valid-json",
      "repeat_prefix_hex": "5b",
      "repeat": 24,
      "middle_ascii": "0",
      "repeat_suffix_hex": "5d",
      "expected_code": "schema",
      "expected_path": "$"
    },
    {
      "name": "integer-over-20-digits",
      "ascii": "{\"x\":100000000000000000000}",
      "expected_code": "json",
      "expected_path": "$"
    },
    {
      "name": "input-over-byte-limit",
      "repeat_hex": "20",
      "repeat": 262145,
      "expected_code": "encoding",
      "expected_path": "$"
    },
    {
      "name": "empty-input",
      "hex": "",
      "expected_code": "encoding",
      "expected_path": "$"
    },
    {
      "name": "negative-number-syntax",
      "ascii": "{\"x\":-}",
